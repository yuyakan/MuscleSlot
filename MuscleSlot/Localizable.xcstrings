          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a tua seleção\nem Exercícios (canto superior direito)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica la selezione\nda Esercizi (in alto a destra)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените выбор\nв разделе Упражнения (справа вверху)"
          }
        },

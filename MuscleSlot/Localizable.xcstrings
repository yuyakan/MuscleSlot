            "value": "Ajustez votre sélection\ndepuis Exercices (en haut à droite)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe deine Auswahl\nunter Übungen an (oben rechts)"
          }
        },

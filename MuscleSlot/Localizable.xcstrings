    "上の絞り込みで器具を増やすと種目が出ます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add equipment in the filter above to see exercises"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方筛选中添加器械即可显示动作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方篩選中新增器械即可顯示動作"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 필터에서 장비를 추가하면 운동이 표시됩니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade equipo en el filtro de arriba para ver ejercicios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez du matériel dans le filtre ci-dessus pour voir des exercices"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge oben im Filter Geräte hinzu, um Übungen zu sehen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione equipamentos no filtro acima para ver exercícios"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona equipamento no filtro acima para ver exercícios"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi attrezzi nel filtro sopra per vedere gli esercizi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте оборудование в фильтре выше, чтобы увидеть упражнения"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan alat di filter di atas untuk melihat latihan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มอุปกรณ์ในตัวกรองด้านบนเพื่อแสดงท่าออกกำลังกาย"

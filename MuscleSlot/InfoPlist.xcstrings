    "NSUserTrackingUsageDescription" : {
      "comment" : "ATT prompt: explains why the app requests tracking permission (for ads).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird verwendet, um dir relevantere Werbung zu zeigen. Du kannst die gesamte App nutzen, auch wenn du das Tracking nicht erlaubst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Used to show ads that are more relevant to you. You can use the entire app even if you don't allow tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se usa para mostrarte anuncios más relevantes. Puedes usar toda la app aunque no permitas el seguimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisé pour vous montrer des publicités plus pertinentes. Vous pouvez utiliser toute l'app même sans autoriser le suivi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Digunakan untuk menampilkan iklan yang lebih relevan bagi Anda. Anda tetap dapat menggunakan seluruh aplikasi meski tidak mengizinkan pelacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usato per mostrarti annunci più pertinenti. Puoi usare tutta l'app anche senza consentire il tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "あなたに合った広告を表示するために使用します。トラッキングを許可しなくてもアプリはすべてご利用いただけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "회원님에게 더 관련성 높은 광고를 표시하기 위해 사용됩니다. 추적을 허용하지 않아도 앱의 모든 기능을 이용할 수 있습니다."
